# Image-only production deployment (compose.prod.yaml)
IMAGE_REPOSITORY=ghcr.io/1045857717/off-duty-squad
# Pin an exact released version for predictable updates and rollback.
GAME_VERSION=4.0.0

# Host port. Bind 127.0.0.1:3000 when a host reverse proxy is used.
PORT=3000
# Public HTTPS origin; optional for local development.
PUBLIC_URL=

# Source builds only (compose.yaml)
NODE_IMAGE=node:24-alpine
